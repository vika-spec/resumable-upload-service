# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./uploads.db

# Production:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_SECRET
TOKEN_EXPIRY_HOURS=24

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Upload limits ─────────────────────────────────────────────────────────────
UPLOAD_EXPIRY_HOURS=2

MAX_FILE_SIZE_GB=10

MAX_CHUNK_SIZE_MB=50
MIN_CHUNK_SIZE_MB=1

# ── Abuse / cost protection ───────────────────────────────────────────────────
QUOTA_USER_STORAGE_GB=1
QUOTA_GLOBAL_GB=40

QUOTA_DAILY_UPLOADS=20

MAX_ACTIVE_UPLOADS_PER_USER=3
MAX_ACTIVE_UPLOADS_GLOBAL=100

# Cleanup every 5 minutes
CLEANUP_INTERVAL_SECONDS=300

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# ── Azure ─────────────────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO